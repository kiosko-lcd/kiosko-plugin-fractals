{
  "name": "kiosko-plugin-fractals",
  "version": "0.2.1",
  "description": "Generative fractal interludes for Kiosko in your theme’s colours: a fractal flame that develops like a photo, a morphing Julia set, a Mandelbrot dive, a meadow of Barnsley ferns and growing coral.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly <info@kioskolcd.dev> (https://kioskolcd.dev)",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "fractal",
    "fractal-flame",
    "julia",
    "generative",
    "interlude",
    "mandelbrot",
    "barnsley-fern",
    "dla"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-fractals#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-fractals.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-fractals/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "fractals",
    "sdk": "^0.2.0",
    "languages": [
      "en",
      "es",
      "de",
      "zh-Hant",
      "zh-Hans"
    ],
    "manifest": "./kiosko-manifest.json"
  },
  "files": [
    "dist",
    "docs",
    "kiosko-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kiosko/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@kiosko/core": "^0.2.1",
    "@kiosko/sdk": "^0.2.1",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
